{
  "name": "partikulier/cdc-v1.7.1",
  "description": "Quality tooling for the Partikulier WordPress theme candidate",
  "type": "project",
  "license": "proprietary",
  "require": {},
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/phpstan": "^1.12",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "phpcs:security": "phpcs --standard=phpcs-security.xml.dist",
    "phpcs:legacy-audit": "phpcs --standard=phpcs.xml.dist",
    "phpstan:changed": "phpstan analyse --configuration=phpstan.neon --memory-limit=1024M --debug"
  }
}
